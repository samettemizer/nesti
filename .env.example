# Total attempts = MAX_CODE_RETRIES + 1  (maps 1:1 to 3 coder tiers)
MAX_CODE_RETRIES=2

# ── CONSUMER SUBSCRIPTIONS – FIRST tier of both cascades ──────────────────────
# Authenticated with `docker exec -it nesti-orchestrator nesti /provider login
# <name>`; a stored session makes that provider outrank the local and paid-API
# tiers, and `nesti /provider logout <name>` removes it from the cascade again.
# Nothing here needs to be set for the tier to work — these only tune it.
# Consumption order; the first logged-in provider is used, the rest are its
# fallbacks (quota safety: put the subscription you want burned first).
NESTI_CONSUMER_PRIORITY=claude,chatgpt-plus,antigravity,copilot
NESTI_CONSUMER_TIMEOUT=600
# Model per consumer provider (defaults shown; must exist on that plan).
# NESTI_CLAUDE_CONSUMER_MODEL defaults to ANTHROPIC_MODEL when unset.
NESTI_CLAUDE_CONSUMER_MODEL=claude-sonnet-4-6
NESTI_CHATGPT_MODEL=gpt-5.1-codex
NESTI_ANTIGRAVITY_MODEL=gemini-3-pro-preview
NESTI_COPILOT_MODEL=gpt-4.1
# Google OAuth client for the Antigravity IDE's installed-app flow (public
# installed-app identifiers, not secret in the OAuth-security sense — PKCE is
# the actual protection — but GitHub's push protection blocks any commit
# containing them regardless, so they must live only here, never in code).
ANTIGRAVITY_CLIENT_ID=your_antigravity_google_oauth_client_id_here
ANTIGRAVITY_CLIENT_SECRET=your_antigravity_google_oauth_client_secret_here


# ── PLATFORM APIs (per-token billed) – SECOND tier ──────────────────────
# Deepseek api – mid-tier fallback ───────────────────────
# register at: https://platform.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=600
# ── Anthropic api – last-resort fallback ───────────────────────────────────
# register at: https://platform.claude.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Telegram Notifications ────────────────────────────────────────────────────
# 1. Create a bot with @BotFather  → get TELEGRAM_BOT_TOKEN
# 2. Add bot to your chat/group   → get TELEGRAM_CHAT_ID via @userinfobot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── GitLab ────────────────────────────────────────────────────────────────────
GITLAB_SSL_VERIFY=true
GITLAB_URL=https://gitlab.yourdomain.com
GITLAB_TOKEN=your_gitlab_personal_access_token_here
GITLAB_PROJECT_PATH=ai/hello-world
GITLAB_USE_SSH=false
GITLAB_REPO_SSH=git@gitlab.yourdomain.com:ai/hello-world.git
GITLAB_REPO_HTTPS=https://gitlab.yourdomain.com/ai/hello-world.git
GITLAB_DEFAULT_BRANCH=main

# ── Issue intake (GitLab Issues) ──────────────────────────────────────────────
# Nesti only picks up OPEN issues carrying this label, so intake is opt-in and
# an issue opened for human discussion is never touched. The lock is the scoped
# label "<label>::in-progress"; a failed run removes it so the issue returns to
# the pending pool and is retried.
GITLAB_ISSUE_LABEL=nesti

# ── Docker Sandbox ────────────────────────────────────────────────────────────
# One image per test layer.  Build them all with:
#   docker build -t nesti-sandbox-php  -f Dockerfile.sandbox      .
#   docker build -t nesti-sandbox-node -f Dockerfile.sandbox.node .
#   docker build -t nesti-sandbox-e2e  -f Dockerfile.sandbox.e2e  .
DOCKER_SANDBOX_PHP_IMAGE=nesti-sandbox-php
DOCKER_SANDBOX_NODE_IMAGE=nesti-sandbox-node
DOCKER_SANDBOX_E2E_IMAGE=nesti-sandbox-e2e
DOCKER_SANDBOX_WORKDIR=/app
# Shared by every sandbox layer.  The PHP/Laravel layer now spends it on
# composer install + migrate + `php artisan test`; the E2E layer additionally
# pays for npm install, the Vite build, and browser startup, so 900 is the
# floor once frontend testing is enabled.
DOCKER_SANDBOX_TIMEOUT=900
# Laravel skeleton version used by the bootstrap step when the repository has no artisan file.
NESTI_LARAVEL_VERSION=^13.0
# Bootstrap runs composer create-project + install:api + composer require dedoc/scramble.
DOCKER_SANDBOX_BOOTSTRAP_TIMEOUT=1800

# ── Stack Detection ───────────────────────────────────────────────────────────
# "auto" (default) inspects the workspace after code generation:
#   .vue files + PHP  → fullstack  (PHPUnit → Vitest → Playwright)
#   .vue files only   → vue        (Vitest → Playwright, PHPUnit skipped)
#   PHP only          → php        (PHPUnit only)
# Pin to php / vue / fullstack only when auto-detection misreads your repo.
NESTI_STACK=auto

# ── Redis (Conversation History) ──────────────────────────────────────────────
# Default: internal Docker Redis (service name = nesti-redis)
# Override to use an external Redis instance:
# REDIS_URL=redis://user:password@192.168.X.X:6379/0
REDIS_URL=redis://nesti-redis:6379/0
CONVERSATION_TTL_DAYS=7

# ── Skill Loading ─────────────────────────────────────────────────────────────
# Set to 1 to inject skill docs into the coding prompt (for large-context providers).
INCLUDE_SKILLS_IN_CODE_PROMPT=1

# ── Workspace ─────────────────────────────────────────────────────────────────
WORKSPACE_PATH=/tmp/nesti-workspace
LOG_LEVEL=INFO

# ── MCP Server ────────────────────────────────────────────────────────────────
# Connect Claude Code CLI after docker-compose up:
#   claude mcp add nesti docker exec -i nesti-mcp python -m mcp_server.server
# VS Code: see .vscode/mcp.json


#-------------------------------------------

# Local LLM tiers are disabled by default because they require dedicated strong GPU/hardware.

# ── Hermes-3 (planner) (if enabled) ──────────
# ollama pull hermes3:8b
HERMES3_LLM_ENABLED=false
HERMES3_LLM_URL=http://192.168.100.4:11434/v1
HERMES3_LLM_MODEL=hermes3:8b
HERMES3_LLM_TIMEOUT=1800

# ── Qwen3:30b (coder) (if enabled) ──────────
LOCAL_LLM_ENABLED=false
LOCAL_LLM_URL=http://192.168.100.2:11434/v1
LOCAL_LLM_MODEL=qwen3:30b-a3b-q4_K_M
LOCAL_LLM_TIMEOUT=1800