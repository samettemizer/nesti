#!/bin/sh
# Host-side `nesti`: forwards to the container CLI; /arch then opens the page in the host browser.
set -e
here=$(CDPATH= cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)
if [ -t 0 ]; then tty=-it; else tty=-i; fi
docker exec $tty nesti-orchestrator nesti "$@"
if [ "${1-}" = "/arch" ] && [ "${2-}" != "--json" ]; then
  page="$here/state/architecture.html"
  if command -v xdg-open >/dev/null 2>&1; then xdg-open "$page" >/dev/null 2>&1 &
  elif command -v open >/dev/null 2>&1; then open "$page"
  else echo "Open file://$page in your browser."; fi
fi
