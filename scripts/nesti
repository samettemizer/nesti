#!/bin/sh
# Host-side `nesti`: no arguments on a TTY open scripts/nesti_menu.py; /arch and /stats open a host browser after the container CLI.
# /plugin and /<installed plugin> [settings|<value>|<KEY> <value>] run on the host (scripts/nesti_plugins.py), using host Git credentials and Docker.
# `update [--check]` runs on the host (scripts/nesti_update.py); other commands on a terminal first show its cached release notice.
set -e
if [ "${1-}" = mcp ]; then
    # MCP acts on the GitLab project or GitHub repository of the client's checkout: the cwd, or the directory given.
    NESTI_CLIENT_REMOTE=$(git -C "${2:-.}" remote get-url origin 2>/dev/null || true)
    export NESTI_CLIENT_REMOTE
    exec docker exec -i -e NESTI_CLIENT_REMOTE nesti-mcp python -m mcp_server.server
fi
here=$(CDPATH= cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)
# Host Python 3.6+ in install.sh's order: active venv, ./.venv, python3, python, py -3; sets py (and pyflag for py -3).
py= pyflag=
find_python() {
    [ -z "$py" ] || return 0
    for candidate in "${VIRTUAL_ENV:+$VIRTUAL_ENV/Scripts/python.exe}" "${VIRTUAL_ENV:+$VIRTUAL_ENV/bin/python}" \
        "$here/.venv/Scripts/python.exe" "$here/.venv/bin/python" python3 python; do
        if [ -n "$candidate" ] && "$candidate" -c 'import sys; sys.exit(sys.version_info < (3, 6))' </dev/null >/dev/null 2>&1; then
            py=$candidate
            return 0
        fi
    done
    if py -3 -c 'import sys; sys.exit(sys.version_info < (3, 6))' </dev/null >/dev/null 2>&1; then
        py=py pyflag=-3
        return 0
    fi
    return 1
}
if [ "${1-}" = update ]; then
    find_python || { echo "nesti: update needs Python 3.6 or newer on the host (tried \$VIRTUAL_ENV, .venv, python3, python, py -3)." >&2; exit 1; }
    exec "$py" ${pyflag:+"$pyflag"} "$here/scripts/nesti_update.py" "$@"
fi
# Release notice: stderr on a terminal only (never mcp or update, both handled above); NESTI_NO_UPDATE_CHECK=1 opts out.
# NESTI_UPDATE_NOTICE_SHOWN keeps nested launcher runs (every menu action) from repeating it.
case "${NESTI_NO_UPDATE_CHECK-}${NESTI_UPDATE_NOTICE_SHOWN-}" in
  ''|0) if [ -t 2 ] && find_python; then
          "$py" ${pyflag:+"$pyflag"} "$here/scripts/nesti_update.py" notice "${1-}" </dev/null || true
        fi ;;
esac
NESTI_UPDATE_NOTICE_SHOWN=1
export NESTI_UPDATE_NOTICE_SHOWN
host=
case "${1-}" in
  /plugin) shift; host=1 ;;
  /arch|/boost|/provider|/stats|/usage) ;;  # container commands (scripts/oauth.py) win over a plugin's name
  /*)
    name=${1#/}
    case "$name" in
      ''|*[!a-z0-9_-]*) ;;
      *) if [ -d "$here/.private/plugins/packages/$name" ]; then  # install creates it, remove deletes it
           shift
           if [ "$#" = 1 ] && [ "$1" = settings ]; then shift; fi
           set -- settings "$name" "$@"
           host=1
         fi ;;
    esac ;;
esac
if [ -n "$host" ]; then
    if find_python; then
        exec "$py" ${pyflag:+"$pyflag"} "$here/scripts/nesti_plugins.py" "$@"
    fi
    echo "nesti: /plugin needs Python 3.6 or newer on the host (tried \$VIRTUAL_ENV, .venv, python3, python, py -3)." >&2
    exit 1
fi
if [ "$#" = 0 ] && [ -t 0 ] && [ -t 1 ]; then
    # Interactive menu: only ./.venv, where install.sh puts Questionary.
    for py in "$here/.venv/Scripts/python.exe" "$here/.venv/bin/python"; do
        if "$py" -c 'import questionary' </dev/null >/dev/null 2>&1; then
            exec "$py" "$here/scripts/nesti_menu.py"
        fi
    done
    echo "nesti: the interactive menu needs Questionary in .venv (run ./install.sh); showing the command list." >&2
fi
if [ -t 0 ]; then tty=-it; else tty=-i; fi
docker exec $tty nesti-orchestrator nesti "$@"
case "${1-} ${2-}" in
  "/arch --json"*) target= ;;
  "/arch "*) target="file://$here/state/architecture.html" ;;
  "/stats "*) target="http://127.0.0.1:8790/" ;;
  *) target= ;;
esac
if [ -n "$target" ]; then
  if [ "$(uname -s)" = Darwin ]; then open "$target"
  elif command -v python3 >/dev/null 2>&1; then python3 -m webbrowser -n "$target" >/dev/null 2>&1 &
  elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$target" >/dev/null 2>&1 &
  else echo "Open $target in your browser."; fi
fi
