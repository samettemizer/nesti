# PHP + Composer sandbox image used by DockerRunner to execute generated code.
#
# Build:
#   docker build -t nesti-sandbox-php -f Dockerfile.sandbox .
#
# Selected via DOCKER_SANDBOX_PHP_IMAGE.  The Node (Vitest) and Playwright
# (E2E) sandboxes live in Dockerfile.sandbox.node and Dockerfile.sandbox.e2e.
#
# The orchestrator mounts the cloned repository at /app.  For a Laravel repo
# (artisan present) it prepares the app and runs `php artisan test`; a non-
# Laravel repo falls back to `./vendor/bin/phpunit --testdox`.
FROM php:8.3-cli

# System libraries required by common PHP extensions
RUN apt-get update && apt-get install -y --no-install-recommends \
    unzip \
    git \
    libzip-dev \
    && docker-php-ext-install zip pdo pdo_mysql \
    && rm -rf /var/lib/apt/lists/*

# Install Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# The orchestrator chowns the mounted workspace back to the host user, so the
# cloned repo is owned by uid 1000 while this container runs as root. git then
# refuses it with "fatal: detected dubious ownership", and because composer
# shells out to git that fatal becomes the FIRST line of the test output fed
# back to the model on a retry — sending it off to fix a git permission
# problem instead of its own code. '*' rather than '/app' because the mount
# point is configurable via DOCKER_SANDBOX_WORKDIR; the container is an
# ephemeral single-purpose sandbox, so there is nothing else here to protect.
RUN git config --global --add safe.directory '*'

WORKDIR /app

# Default command: install deps, prepare the Laravel app (if any), run tests.
# Kept byte-identical to docker_runner._TEST_COMMAND so the image is usable
# standalone.  The EXIT trap restores host ownership of everything the
# container creates even when the suite goes red — without it a failing
# attempt would leave the workspace root-owned and the retry could not write.
CMD ["bash", "-lc", "set -e; NESTI_OWNER=\"$(stat -c %u:%g /app)\"; trap 'chown -R \"$NESTI_OWNER\" /app || true' EXIT; composer install --no-interaction --prefer-dist --no-progress; if [ -f artisan ]; then [ -f .env ] || cp .env.example .env; php artisan key:generate --force; php artisan config:clear; rm -f database/database.sqlite; touch database/database.sqlite; php artisan migrate --force; php artisan test; else ./vendor/bin/phpunit --testdox; fi"]
