# Boost only: install and render in a disposable project copy, never the shared app.
# Build: docker build -t nesti-sandbox-boost -f Dockerfile.sandbox.boost .
FROM php:8.4-cli

RUN apt-get update && apt-get install -y --no-install-recommends \
    unzip git libzip-dev libpq-dev libpng-dev libjpeg62-turbo-dev libfreetype6-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install zip bcmath gd pdo_mysql pdo_pgsql \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY scripts/boost_bridge.php /opt/nesti/boost_bridge.php
RUN git config --global --add safe.directory '*'

WORKDIR /app
